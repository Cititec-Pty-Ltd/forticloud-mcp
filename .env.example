# Fortinet FortiCloud, read-only. One IAM API user (FortiCloud > IAM > Users > Add API User)
# whose permission profile gives READ-ONLY access to Asset Management and FortiGate Cloud
# (FortiManagement Cloud). Its credentials file has the API ID and password.
FORTICLOUD_API_ID=
# Never logged or returned; removed from every error message.
FORTICLOUD_API_PASSWORD=

# Optional overrides (defaults shown). Change only if FortiCloud moves an endpoint.
# OAuth token endpoint (the trailing slash matters).
# FORTICLOUD_AUTH_URL=https://customerapiauth.fortinet.com/api/v1/oauth/token/
# Asset Management API v3.
# FORTICLOUD_ASSET_URL=https://support.fortinet.com/ES/api/registration/v3
# FortiGate Cloud API. Global (also Canada): api.; US: usapi.; Europe: euapi.; Japan: jpapi.
# FORTICLOUD_FGT_URL=https://api.fortigate.forticloud.com/forticloudapi/v1
# FORTICLOUD_ASSET_CLIENT_ID=assetmanagement
# FORTICLOUD_FGT_CLIENT_ID=fortigatecloud

# off disables the <forticloud-data> untrusted-text wrapper on results.
FORTICLOUD_UNTRUSTED_MARKERS=on

# Log level (stderr): debug, info, warn, error. Tool arguments and secrets are never logged.
LOG_LEVEL=info
